EQUAHOME_DATABASE_URL=postgresql+psycopg://equahome:equahome@localhost:5432/equahome
EQUAHOME_JWT_SECRET=dev-only-change-me
EQUAHOME_STORAGE_DIR=./uploads
# IA real vía Groq — pon el provider en "groq" y tu API key de
# https://console.groq.com/keys. Implementación: app/services/ai/groq.py.
EQUAHOME_AI_PROVIDER=mock
EQUAHOME_GROQ_API_KEY=
EQUAHOME_GROQ_MODEL=openai/gpt-oss-120b
# Modelo de visión para fotos; requiere acceso en tu cuenta de Groq.
EQUAHOME_GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
EQUAHOME_GROQ_BASE_URL=https://api.groq.com/openai/v1
